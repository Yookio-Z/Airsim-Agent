__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Runtime-local state and generated files
.runtime/
.airsim_agent/
*.log

# Captured simulator images are served locally and can be regenerated.
captures/

# 旧目标检测权重（产品已移除 YOLO；见 models/README.md）。*.pt 一律不入库。
*.pt

# Runtime state, logs and caches (may contain local API keys / credentials).
src/data/
src/ui/static/tile_cache/
logs/

# Third-party source clones are vendored locally, not tracked.
third_party/

# One-off debug probes and dev-phase verification scripts.
scripts/manual/
scripts/verify_p*.py

# Internal documents (design drafts, failure analyses, research notes, ideas)
# are deliberately NOT tracked: the repository may be public and these are
# working material, not product documentation. The files stay in the local
# working tree. Previously listed one by one (docs/dev_task_list.md,
# docs/px4_agent_handoff.md); now the whole folder.
docs/

# ZCode tool session artifacts.
.zcode/

# 本地工具工作目录
.workbuddy/

# Coverage data
.coverage
.coverage.*
htmlcov/
_cmd*.json
shots/

# Local environment overrides (may hold credentials)
.env

# Large local bundles (not source)
PX4-Autopilot.zip
*.zip
